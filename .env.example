# Placeholder-only example — copy to `.env` (0600, never committed) and fill in.
# Every key below mirrors the zod env schema in packages/config/src/env.ts.
PB_URL=http://127.0.0.1:8090
PB_SERVICE_EMAIL=
PB_SERVICE_PASSWORD=
JINA_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GROQ_API_KEY=
GITHUB_TOKEN=
SAMBANOVA_API_KEY=
DISCORD_TOKEN=
# D-14: channel IDs for the three new job/loot buckets (placeholder only — never real IDs)
DISCORD_CHANNEL_JOBS_SYS_CLOUD=
DISCORD_CHANNEL_JOBS_GENERAL=
DISCORD_CHANNEL_LOOT=
# D-06: fellowship allowlist extension (append new programs without a release)
FELLOWSHIP_ALLOWLIST_EXTRA=
# CR-02 / G-06-1: operator allowlist for DM taste-rule creation (fail-closed when empty)
OPERATOR_USER_IDS=
LOG_LEVEL=info

# Phase 6: local DK/Udupi domain inventory (D-01)
LOCAL_WATCHLIST_DOMAINS=
# Phase 6: X/LinkedIn session-cookie file path (D-07)
SOCIAL_COOKIES_PATH=
# Phase 6: external #announcements source channel for relay (D-04)
DISCORD_RELAY_SOURCE_CHANNEL_ID=
# Phase 6: bucket channel IDs (env-ID-first resolution in router-service)
BOOKMARK_EMOJI_ID=
DISCORD_CHANNEL_LOCAL=
DISCORD_CHANNEL_TRAVEL=
DISCORD_CHANNEL_TBA=
DISCORD_CHANNEL_RELAY=
DISCORD_CHANNEL_TRAINING=
# Phase 7: ops-health channel ID (env-ID-first, D-15)
DISCORD_CHANNEL_OPS_HEALTH=
# Phase 7: client staleness banner threshold in ms (D-07, ~15s heartbeat)
STALENESS_THRESHOLD_MS=90000
# Phase 7: hard cap on concurrent SSE streams (D-08, ~2 viewers)
SSE_VIEWER_CAP=2
# Phase 7: SSE connection timeout in ms (CR-04, reap stalled sockets)
SSE_CONNECTION_TIMEOUT_MS=120000
# Phase 7: GC 25h-missing alert threshold in hours (D-14)
GC_ALERT_HOURS=25
# G-07-WR-01: owner email for application-layer /api/stream auth check
ACCESS_OWNER_EMAIL=
# Event bucket channel IDs (env-ID-first resolution in router-service)
DISCORD_CHANNEL_PRIORITY_SYS_CP_SEC=
DISCORD_CHANNEL_ONLINE_1LAKH=
