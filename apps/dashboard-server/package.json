{
  "name": "@zod/dashboard-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gc": {
      "types": "./dist/gc.d.ts",
      "default": "./dist/gc.js"
    },
    "./alerts": {
      "types": "./dist/alerts.d.ts",
      "default": "./dist/alerts.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@zod/config": "workspace:*",
    "@zod/db-hot": "workspace:*",
    "@zod/logger": "workspace:*",
    "eventsource": "^5.1.3",
    "pocketbase": "^0.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
