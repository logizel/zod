{
  "name": "@zod/discord-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/router-service.js",
  "types": "./dist/router-service.d.ts",
  "exports": {
    ".": {
      "types": "./dist/router-service.d.ts",
      "default": "./dist/router-service.js"
    },
    "./portals/*": {
      "types": "./dist/portals/*.d.ts",
      "default": "./dist/portals/*.js"
    },
    "./portals/jobs/*": {
      "types": "./dist/portals/jobs/*.d.ts",
      "default": "./dist/portals/jobs/*.js"
    },
    "./portals/loot/*": {
      "types": "./dist/portals/loot/*.d.ts",
      "default": "./dist/portals/loot/*.js"
    },
    "./link-hop": {
      "types": "./dist/link-hop.d.ts",
      "default": "./dist/link-hop.js"
    },
    "./prize-gate": {
      "types": "./dist/prize-gate.d.ts",
      "default": "./dist/prize-gate.js"
    },
    "./domain-filter": {
      "types": "./dist/domain-filter.d.ts",
      "default": "./dist/domain-filter.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./router-service": {
      "types": "./dist/router-service.d.ts",
      "default": "./dist/router-service.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "default": "./dist/relay.js"
    },
    "./reminder": {
      "types": "./dist/reminder.d.ts",
      "default": "./dist/reminder.js"
    },
    "./bookmark": {
      "types": "./dist/bookmark.d.ts",
      "default": "./dist/bookmark.js"
    },
    "./taste-ingest": {
      "types": "./dist/taste-ingest.d.ts",
      "default": "./dist/taste-ingest.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@zod/browser": "workspace:*",
    "@zod/config": "workspace:*",
    "@zod/db-cold": "workspace:*",
    "@zod/db-hot": "workspace:*",
    "@zod/logger": "workspace:*",
    "@zod/sanitize": "workspace:*",
    "cheerio": "^1.2.0",
    "discord.js": "^14.25.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
