{
  "name": "@zod/db-hot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./scratchpad": {
      "types": "./dist/scratchpad.d.ts",
      "default": "./dist/scratchpad.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@zod/config": "workspace:*",
    "eventsource": "^5.1.3",
    "pocketbase": "^0.28.1",
    "zod": "^4.6.7",
    "@zod/dedup": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}